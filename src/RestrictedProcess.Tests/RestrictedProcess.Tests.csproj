<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>Exe</OutputType>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
    <PackageReference Include="xunit.v3" Version="4.0.0" />
    <PackageReference Include="Xunit.StaFact" Version="4.0.23" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RestrictedProcess\RestrictedProcess.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <CodeAnalysisRuleSet>..\Rules.ruleset</CodeAnalysisRuleSet>
  </PropertyGroup>

  <ItemGroup>
    <AdditionalFiles Include="..\stylecop.json" />
  </ItemGroup>

  <!--
    These tests are not unit tests: each one compiles an executable, creates a job object and a desktop,
    then measures how much processor time and memory the sandboxed program used. Running them in parallel
    makes those measurements a function of how busy the machine is, which is how a program that finishes in
    50 ms ends up tripping a time limit. It also multiplies the number of threads blocked inside the
    synchronous Execute overload, starving the thread pool its asynchronous machinery needs.
  -->
  <ItemGroup>
    <None Update="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
