<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.11" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <CodeAnalysisRuleSet>..\Rules.ruleset</CodeAnalysisRuleSet>
    <PackageId>RestrictedProcess.NET</PackageId>
    <Version>2.0.0</Version>
    <Authors>Nikolay.IT</Authors>
    <Company />
    <Product>RestrictedProcess.NET</Product>
    <PackageProjectUrl>https://github.com/NikolayIT/RestrictedProcess.NET</PackageProjectUrl>
    <Description>A .NET library containing restricted process executor which can be used to run Windows programs with restricted rights. RestrictedProcess.NET can also limit the time and the memory of a running process.</Description>
    <PackageReleaseNotes>Targeting .NET Standard 2.0, .NET 8 and .NET 10. Replaced log4net with Microsoft.Extensions.Logging.Abstractions. Chromium-sandbox-class hardening (configurable via RestrictedProcessOptions): restricted token levels with dropped privileges, deny-only Administrators and restricting SIDs; inherited-handle whitelist; process mitigation policies; kernel-level child-process ban; scrubbed environment; throwaway desktop; job priority/affinity/CPU-rate limits; and bounded output reads (new OutputLimit result type). Breaking: executor defaults are stricter.</PackageReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Nikolay.IT</Copyright>
    <RepositoryUrl>https://github.com/NikolayIT/RestrictedProcess.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Restricted, Process, Sandbox, Windows Executable</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' != 'netstandard2.0'">
    <AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
      <_Parameter1>windows</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <AdditionalFiles Include="..\stylecop.json" />
  </ItemGroup>

</Project>
