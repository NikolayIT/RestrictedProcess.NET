<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0-windows;net10.0-windows</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.11" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="10.0.11" />
    <PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <CodeAnalysisRuleSet>..\Rules.ruleset</CodeAnalysisRuleSet>
    <PackageId>RestrictedProcess.NET</PackageId>
    <Version>2.0.0</Version>
    <Authors>Nikolay.IT</Authors>
    <Company />
    <Product>RestrictedProcess.NET</Product>
    <PackageProjectUrl>https://github.com/NikolayIT/RestrictedProcess.NET</PackageProjectUrl>
    <Description>A .NET library containing restricted process executor which can be used to run Windows programs with restricted rights. RestrictedProcess.NET can also limit the time and the memory of a running process.</Description>
    <PackageReleaseNotes>Targeting .NET 8 and .NET 10 (Windows). Replaced log4net with Microsoft.Extensions.Logging.Abstractions. Chromium-class sandbox hardening configurable via RestrictedProcessOptions: tiered restricted token levels (Limited / WriteRestricted / Restricted / Lockdown) with all groups deny-only, a unique per-run SID, a locked-down token default DACL and a hardened token label; job attachment at creation via PROC_THREAD_ATTRIBUTE_JOB_LIST; 128-bit process mitigation policies; kernel-level child-process ban and desktop-app breakaway block; inherited-handle whitelist; scrubbed environment; a throwaway desktop with a least-privilege DACL and a matching mandatory label; optional AppContainer/LPAC network blocking; job priority/affinity/CPU-rate limits. Measurement is now driven by job-object accounting and I/O completion port notifications instead of polling, with separate CPU-time and wall-clock limits. Breaking: IExecutor now takes an ExecutionRequest and is async-first, limits are 64-bit, and the executor defaults are stricter.</PackageReleaseNotes>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Copyright>Nikolay.IT</Copyright>
    <RepositoryUrl>https://github.com/NikolayIT/RestrictedProcess.NET</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>Restricted, Process, Sandbox, Windows Executable</PackageTags>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <AdditionalFiles Include="..\stylecop.json" />
  </ItemGroup>

</Project>
